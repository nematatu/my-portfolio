{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "front run",
        "type": "shell",
        "command": "npm run dev",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "shell run",
        "type": "shell",
        "command": "/bin/zsh",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "tasks",
        "type": "shell",
        "dependsOn": [
          "front run",
          "shell run"
        ],
        "runOptions": {
          "runOn": "folderOpen"
        }
      }
    ]
  }